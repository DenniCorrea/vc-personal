// Schema de dados do VC Personal.
// Cada fase adiciona seus proprios models aqui e gera uma nova migration —
// nao criamos hoje tabela que so vai ser usada la na frente.
//
// Saiba mais: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // A connection string (DATABASE_URL / DIRECT_URL) mora em prisma.config.ts,
  // nao aqui — e assim desde o Prisma 7.
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// Os 3 perfis do app. Uma unica tabela Usuario com um campo `role` (em vez de
// 3 tabelas separadas) porque os 3 perfis compartilham login, nome, telefone
// e o mesmo fluxo de autenticacao — so o que cada um pode FAZER difere, e isso
// e responsabilidade da camada de autorizacao (Fase 2), nao do modelo de dados.
enum Role {
  ALUNO
  PERSONAL_PARCEIRO
  ADMIN
}

// Os dois negocios do Victor, que compartilham infraestrutura (usuario, login,
// pagamento, assinatura) mas nunca devem misturar conteudo/regras. Um Plano
// pertence a exatamente um Produto.
enum Produto {
  ALUNO
  MENTORIA
}

enum Periodicidade {
  MENSAL
  TRIMESTRAL
  ANUAL
}

enum StatusAssinatura {
  // Escolheu o plano mas ainda nao pagou — o pagamento (Fase 5) e quem muda
  // isso pra ATIVA. Antes da Fase 5 existir, e o estado final mesmo (nao tem
  // cobranca de verdade rodando ainda).
  PENDENTE
  ATIVA
  ATRASADA
  CANCELADA
  EXPIRADA
}

// Como o aluno é atendido dentro de uma sessao do plano.
enum TipoAtendimento {
  VIDEO
  PRESENCIAL
  DISTANCIA
}

// ---------------------------------------------------------------------------
// Modelos
// ---------------------------------------------------------------------------

model Usuario {
  id        String  @id @default(uuid())
  email     String  @unique
  // Hash da senha (bcrypt), nunca a senha em texto puro. Preenchido na Fase 2
  // quando a autenticacao entrar; por enquanto so reservamos o campo.
  senhaHash String
  nome      String
  telefone  String?

  // --- Dados LGPD-sensiveis ---
  // Nunca guardamos o CPF em texto puro. `cpfHash` e um hash (SHA-256 + salt
  // fixo do app) usado so para checar duplicidade de cadastro — ele nao serve
  // pra "descobrir" o CPF de volta. Se um dia precisarmos EXIBIR o CPF (ex.
  // emitir nota fiscal), isso pede um campo cifrado reversivel a parte, com
  // chave em variavel de ambiente, e endpoint restrito a admin — decisao pra
  // quando essa necessidade aparecer de verdade, nao antes.
  cpfHash             String?   @unique
  endereco            String?
  consentimentoLgpdEm DateTime?

  role Role @default(ALUNO)

  // Soft delete: "desligar" o usuario sem apagar o historico de pagamento e
  // assinatura, que a LGPD e a contabilidade exigem manter por um tempo.
  // Exclusao definitiva (direito ao esquecimento) e uma operacao separada,
  // explicita, feita sob pedido do titular — nao e so virar esse campo pra false.
  ativo Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  assinaturas Assinatura[]

  @@map("usuarios")
}

// Catalogo unico de planos dos dois produtos. Em vez de uma tabela por
// produto (PlanoAluno, PlanoConsultoria — o que tinhamos antes), um Plano
// carrega o campo `produto` que diz o que ele vende; os campos especificos
// de ALUNO (frequenciaSemanal, tiposAtendimento, incluiNutricao) ficam
// opcionais e simplesmente nao se aplicam a um plano de MENTORIA. A troca:
// lancar um produto novo no futuro e 1 linha a mais no enum `Produto`, nao
// uma tabela nova + tela de admin nova + FK nova na Assinatura.
model Plano {
  id      String  @id @default(uuid())
  produto Produto

  nome      String
  descricao String?

  // Decimal (nao Float!) para dinheiro: Float arredonda binario e pode gerar
  // R$ 19,999999999 em vez de R$ 20,00. Decimal(10,2) guarda exatamente 2 casas.
  preco         Decimal       @db.Decimal(10, 2)
  periodicidade Periodicidade @default(MENSAL)

  // --- especifico de Produto.ALUNO — fica null em planos de MENTORIA ---
  frequenciaSemanal Int? // 1 a 7x/semana (validado na camada de aplicacao)
  limiteAgendamentos Int? // creditos de agendamento por ciclo — usado na Fase 4
  incluiNutricao     Boolean           @default(false)
  tiposAtendimento   TipoAtendimento[]

  // Lista livre pro admin descrever diferenciais sem precisar de migration
  // pra cada beneficio novo (ex: "acesso a grupo exclusivo", "avaliacao
  // fisica mensal"). Texto puro de proposito — nao e regra que o sistema
  // aplica automaticamente, e so o que aparece pro cliente.
  beneficios String[]

  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  assinaturas Assinatura[]

  // Dois planos do MESMO produto nao podem ter nome igual (evita catalogo
  // confuso), mas um plano de ALUNO e um de MENTORIA podem, em tese,
  // coincidir de nome sem problema.
  @@unique([produto, nome])
  @@map("planos")
}

model Assinatura {
  id String @id @default(uuid())

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId String

  plano   Plano  @relation(fields: [planoId], references: [id])
  planoId String

  status               StatusAssinatura @default(PENDENTE)
  dataInicio           DateTime         @default(now())
  dataProximaRenovacao DateTime
  renovacaoAutomatica  Boolean          @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("assinaturas")
}
