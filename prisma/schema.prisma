// Schema de dados do VC Personal.
// Cada fase adiciona seus proprios models aqui e gera uma nova migration —
// nao criamos hoje tabela que so vai ser usada la na frente.
//
// Saiba mais: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // A connection string (DATABASE_URL / DIRECT_URL) mora em prisma.config.ts,
  // nao aqui — e assim desde o Prisma 7.
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// Os 3 perfis do app. Uma unica tabela Usuario com um campo `role` (em vez de
// 3 tabelas separadas) porque os 3 perfis compartilham login, nome, telefone
// e o mesmo fluxo de autenticacao — so o que cada um pode FAZER difere, e isso
// e responsabilidade da camada de autorizacao (Fase 2), nao do modelo de dados.
enum Role {
  ALUNO
  PERSONAL_PARCEIRO
  ADMIN
}

// Os dois negocios do Victor, que compartilham infraestrutura (usuario, login,
// pagamento, assinatura) mas nunca devem misturar conteudo/regras. Um Plano
// pertence a exatamente um Produto.
enum Produto {
  ALUNO
  MENTORIA
}

enum Periodicidade {
  MENSAL
  TRIMESTRAL
  ANUAL
}

enum StatusAssinatura {
  // Escolheu o plano mas ainda nao pagou — o pagamento (Fase 5) e quem muda
  // isso pra ATIVA. Antes da Fase 5 existir, e o estado final mesmo (nao tem
  // cobranca de verdade rodando ainda).
  PENDENTE
  ATIVA
  ATRASADA
  CANCELADA
  EXPIRADA
}

// Como o aluno é atendido dentro de uma sessao do plano.
enum TipoAtendimento {
  VIDEO
  PRESENCIAL
  DISTANCIA
}

enum StatusAgendamento {
  AGENDADO
  CONFIRMADO
  CONCLUIDO
  CANCELADO
  FALTOU
}

enum MetodoPagamento {
  CARTAO
  DEBITO
  PIX
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  ESTORNADO
}

// Os 5 pilares da mentoria (secao 3 do briefing do Victor). Enum fixo por
// enquanto — o briefing ja avisa que isso deve virar configuravel pelo admin
// "futuramente", entao comecamos simples e migramos pra tabela se um dia
// isso virar necessidade real.
enum Pilar {
  POSICIONAMENTO
  ABORDAGEM
  MAPEAMENTO
  VENDAS
  FIDELIZACAO
}

enum TipoConteudo {
  PADRAO // sempre disponivel pra quem assina
  SEMANAL // o "1 video novo por semana" do briefing
}

// So agua e sono por enquanto. Enum de novo, mesmo raciocinio do Pilar: o
// briefing pede pra "permitir adicionar novos habitos futuramente", e um
// enum novo e barato de migrar quando isso virar necessidade real.
enum TipoHabito {
  AGUA
  SONO
}

enum FrequenciaMensagem {
  DIARIA
  SEMANAL
}

enum TipoAlerta {
  RENOVACAO_PROXIMA // pro proprio usuario: sua assinatura vence em breve
  ASSINATURA_ATRASADA // pro proprio usuario: passou da data e nao renovou
  ALUNO_SEM_RENOVACAO // pro ADMIN: fulano nao renovou, hora do follow-up
  HABITO_AGUA
  HABITO_SONO
  AGENDA // sessao chegando
  SOLICITACAO_EXCLUSAO // pro ADMIN: pessoa pediu exclusao da conta (LGPD)
  MODERACAO // pro proprio usuario: sua participacao na comunidade mudou
}

// Secao "objetivo principal" da anamnese (handoff Metodo Lider, tela 3a).
enum ObjetivoAluno {
  HIPERTROFIA
  EMAGRECIMENTO
  SAUDE_CONSTANCIA
  PERFORMANCE
}

enum TempoTreino {
  NUNCA_TREINOU
  UM_A_TRES_ANOS
  MAIS_DE_TRES_ANOS
}

// Resultado do check-in de uma refeicao especifica num dia especifico
// (secao 8 do briefing + tela 2b do handoff).
enum StatusCheckinNutricional {
  SEGUIU
  ADAPTOU
}

// ---------------------------------------------------------------------------
// Modelos
// ---------------------------------------------------------------------------

model Usuario {
  id        String  @id @default(uuid())
  email     String  @unique
  // Hash da senha (bcrypt), nunca a senha em texto puro. Preenchido na Fase 2
  // quando a autenticacao entrar; por enquanto so reservamos o campo.
  senhaHash String
  nome      String
  telefone  String?

  // --- Dados LGPD-sensiveis ---
  // Nunca guardamos o CPF em texto puro. `cpfHash` e um hash (SHA-256 + salt
  // fixo do app) usado so para checar duplicidade de cadastro — ele nao serve
  // pra "descobrir" o CPF de volta. Se um dia precisarmos EXIBIR o CPF (ex.
  // emitir nota fiscal), isso pede um campo cifrado reversivel a parte, com
  // chave em variavel de ambiente, e endpoint restrito a admin — decisao pra
  // quando essa necessidade aparecer de verdade, nao antes.
  cpfHash             String?   @unique
  endereco            String?
  consentimentoLgpdEm DateTime?

  // URL da foto no Cloudinary (plano gratuito) — null enquanto a pessoa nao
  // envia uma. Usado no avatar do dashboard e no header do painel do admin.
  avatarUrl String?

  role Role @default(ALUNO)

  // Soft delete: "desligar" o usuario sem apagar o historico de pagamento e
  // assinatura, que a LGPD e a contabilidade exigem manter por um tempo.
  // Exclusao definitiva (direito ao esquecimento) e uma operacao separada,
  // explicita, feita sob pedido do titular — nao e so virar esse campo pra false.
  ativo Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  assinaturas           Assinatura[]
  agendamentos          Agendamento[]
  pagamentos            Pagamento[]
  treinos               Treino[]
  habitos               Habito[]
  alertas               Alerta[]
  // Assinaturas de cortesia que ESSE usuario (um admin) concedeu pra outras
  // pessoas — nao e "as assinaturas dele", e um log de quem liberou o que.
  assinaturasConcedidas Assinatura[]            @relation("AssinaturasConcedidas")
  logsAdmin             LogAdmin[]
  tokensRecuperacao     TokenRecuperacaoSenha[]

  // --- Metodo Lider (Fase 12) ---
  anamnese          Anamnese?
  avaliacoes        Avaliacao[]
  execucoes         ExecucaoExercicio[]
  planoNutricional  PlanoNutricional?
  fotosProgresso    FotoProgresso[]
  // Mensagens onde esse usuario e o "dono" da conversa (sempre o aluno —
  // como so existe 1 admin, a thread inteira e identificada so por isso,
  // sem precisar de uma tabela Conversa separada).
  mensagens         Mensagem[]          @relation("ThreadDoAluno")
  // Mensagens que ESSE usuario escreveu dentro de alguma thread (aluno
  // escrevendo na propria, ou o admin respondendo a de um aluno).
  mensagensEnviadas Mensagem[]          @relation("AutorMensagem")

  // --- Mentoria B2B (28/08/2026) ---
  diagnostico    Diagnostico?
  progressoAulas Progresso[]
  posts          Post[]
  comentarios    Comentario[]
  curtidas       Curtida[]

  // --- Moderacao da comunidade (10/09/2026) ---
  // Suspensao TEMPORARIA de postar/comentar. Separado de `ativo` de
  // proposito: desativar a conta corta o acesso ao produto inteiro (aulas,
  // sessoes, material) que a pessoa pagou. Quebrar a regra da comunidade
  // nao justifica tirar o que ela comprou — justifica tirar a voz no feed.
  // `null` = sem restricao. Data no futuro = silenciado ate la.
  comunidadeSilenciadaAte DateTime?
  comunidadeMotivoSilencio String?

  denunciasFeitas    Denuncia[] @relation("Denunciante")
  denunciasResolvidas Denuncia[] @relation("ModeradorDenuncia")

  @@map("usuarios")
}

// Catalogo unico de planos dos dois produtos. Em vez de uma tabela por
// produto (PlanoAluno, PlanoConsultoria — o que tinhamos antes), um Plano
// carrega o campo `produto` que diz o que ele vende; os campos especificos
// de ALUNO (frequenciaSemanal, tiposAtendimento, incluiNutricao) ficam
// opcionais e simplesmente nao se aplicam a um plano de MENTORIA. A troca:
// lancar um produto novo no futuro e 1 linha a mais no enum `Produto`, nao
// uma tabela nova + tela de admin nova + FK nova na Assinatura.
model Plano {
  id      String  @id @default(uuid())
  produto Produto

  nome      String
  descricao String?

  // Decimal (nao Float!) para dinheiro: Float arredonda binario e pode gerar
  // R$ 19,999999999 em vez de R$ 20,00. Decimal(10,2) guarda exatamente 2 casas.
  preco         Decimal       @db.Decimal(10, 2)
  periodicidade Periodicidade @default(MENSAL)

  // Preco de UMA sessao avulsa (quando estoura o limite semanal). Campo
  // explicito, definido pelo admin — nao e uma fracao calculada do `preco`
  // mensal, porque essa conta (quantas sessoes "cabem" no preco do plano)
  // e uma decisao de negocio, nao aritmetica.
  precoAvulso Decimal? @db.Decimal(10, 2)

  // `limiteAgendamentos` vale pros dois produtos (quantas sessoes o ciclo
  // semanal cobre — aluno E mentoria tem essa trava, confirmado com o
  // Victor). O resto abaixo e especifico de Produto.ALUNO e fica null em
  // planos de MENTORIA.
  limiteAgendamentos Int?
  frequenciaSemanal  Int? // 1 a 7x/semana (validado na camada de aplicacao)
  incluiNutricao     Boolean           @default(false)
  tiposAtendimento   TipoAtendimento[]

  // Especifico de Produto.MENTORIA: se esse plano da acesso a TODOS os
  // bonus (nao existe bonus por assinatura avulsa — e tudo ou nada, igual
  // ao catalogo do handoff: "Fundamento: —, Autoridade/Escala: todos").
  incluiBonus Boolean @default(false)

  // Lista livre pro admin descrever diferenciais sem precisar de migration
  // pra cada beneficio novo (ex: "acesso a grupo exclusivo", "avaliacao
  // fisica mensal"). Texto puro de proposito — nao e regra que o sistema
  // aplica automaticamente, e so o que aparece pro cliente.
  beneficios String[]

  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  assinaturas   Assinatura[]
  // So especifico de Produto.MENTORIA: quais aulas esse plano libera. Uma
  // Aula sem nenhum plano marcado em "Quem ve" fica invisivel pra todo
  // mundo — e assim que o rascunho nao vaza antes do admin configurar a
  // visibilidade.
  aulasVisiveis Aula[]

  // Dois planos do MESMO produto nao podem ter nome igual (evita catalogo
  // confuso), mas um plano de ALUNO e um de MENTORIA podem, em tese,
  // coincidir de nome sem problema.
  @@unique([produto, nome])
  @@map("planos")
}

model Assinatura {
  id String @id @default(uuid())

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId String

  plano   Plano  @relation(fields: [planoId], references: [id])
  planoId String

  status               StatusAssinatura @default(PENDENTE)
  dataInicio           DateTime         @default(now())
  dataProximaRenovacao DateTime
  renovacaoAutomatica  Boolean          @default(true)

  // Acesso concedido pelo admin sem pagamento (cliente VIP, cortesia,
  // periodo de teste). Quando `dataProximaRenovacao` passar, o motor de
  // alertas da Fase 10 trata do mesmo jeito que uma assinatura paga vencida
  // — o admin decide na hora se renova a cortesia ou deixa vencer, sem
  // precisar de logica separada pra isso.
  cortesia       Boolean  @default(false)
  concedidaPor   Usuario? @relation("AssinaturasConcedidas", fields: [concedidaPorId], references: [id])
  concedidaPorId String?

  // Preenchido so quando o pagamento e por cartao: e o id da assinatura
  // recorrente (PreApproval) no Mercado Pago, que cobra sozinha todo mes.
  // Pix e debito ficam null aqui — cada ciclo deles gera um Pagamento novo
  // em vez de uma cobranca automatica (o Mercado Pago nao suporta
  // recorrencia confiavel pra esses dois metodos).
  mercadoPagoPreapprovalId String? @unique

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  agendamentos Agendamento[]
  pagamentos   Pagamento[]

  @@map("assinaturas")
}

// Um horario que o admin abriu na agenda. Existe independente de estar
// ocupado ou nao — "ocupado" e so "existe um Agendamento nao-cancelado
// apontando pra ele", nao um campo aqui. Isso evita ter que sincronizar um
// booleano "reservado" toda vez que um Agendamento muda de status.
model Horario {
  id String @id @default(uuid())

  produto         Produto
  tipoAtendimento TipoAtendimento?

  inicio DateTime
  fim    DateTime

  // Fechar um horario que ainda nao foi usado (ex: Victor bloqueou aquele
  // dia). Diferente de deletar: preserva o historico se algum dia teve
  // Agendamento vinculado.
  ativo Boolean @default(true)

  criadoEm     DateTime      @default(now())
  agendamentos Agendamento[]

  @@map("horarios")
}

// Uma tentativa de reserva de alguem contra um Horario. Nunca e apagado —
// cancelar so muda o `status` pra CANCELADO (o que libera o Horario pra
// outra pessoa), preservando o historico de falta/cancelamento que a Fase
// 10 (retencao) vai usar.
model Agendamento {
  id String @id @default(uuid())

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId String

  // Contra qual assinatura esse agendamento consome credito do ciclo. Nao
  // usamos so `usuarioId` pra isso porque, no futuro, um usuario podera ter
  // mais de uma assinatura no historico — precisamos saber a assinatura
  // exata vigente quando o agendamento foi feito.
  assinatura   Assinatura @relation(fields: [assinaturaId], references: [id])
  assinaturaId String

  horario   Horario @relation(fields: [horarioId], references: [id])
  horarioId String

  status StatusAgendamento @default(AGENDADO)

  // true = fora do limite do plano daquele ciclo. A Fase 5 vai exigir
  // pagamento pra esses; por enquanto (como a Assinatura PENDENTE) so fica
  // registrado.
  avulso Boolean @default(false)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  pagamentos Pagamento[]

  @@map("agendamentos")
}

// Um cobranca real, processada pelo Mercado Pago. Cada Pagamento e ou uma
// mensalidade (assinatura) ou uma sessao avulsa (agendamento) — nunca as
// duas, mas ao contrario do Plano/Produto, aqui nao da pra unificar num
// campo so: sao coisas diferentes sendo cobradas, nao duas variantes da
// mesma coisa.
model Pagamento {
  id String @id @default(uuid())

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId String

  assinatura   Assinatura? @relation(fields: [assinaturaId], references: [id])
  assinaturaId String?

  agendamento   Agendamento? @relation(fields: [agendamentoId], references: [id])
  agendamentoId String?

  // Decimal, nunca Float — mesma razao do preco do Plano.
  valorOriginal Decimal @db.Decimal(10, 2)
  desconto      Decimal @default(0) @db.Decimal(10, 2) // 6% quando o metodo e PIX
  valorFinal    Decimal @db.Decimal(10, 2)

  metodo MetodoPagamento
  status StatusPagamento @default(PENDENTE)

  // Criado ANTES da pessoa pagar (e o "carrinho" — Preference pra
  // pagamento avulso/Pix/debito, PreApproval pra assinatura de cartao).
  mercadoPagoPreferenceId String? @unique
  // Só existe DEPOIS que o Mercado Pago confirma o pagamento de verdade —
  // e o dado que o webhook traz, nunca o que o navegador do cliente informa.
  mercadoPagoPaymentId    String? @unique

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("pagamentos")
}

// O video em si fica hospedado no Vimeo — aqui so guardamos a referencia e
// quem pode assistir. Video de exercicio (Fase 7) e video de mentoria (Fase
// 8) vao APONTAR pra um Video daqui, em vez de duplicar essa logica de
// acesso em cada um.
model Video {
  id      String  @id @default(uuid())
  produto Produto // mesma regra do Plano/Horario: define quem pode ver

  titulo    String
  descricao String?

  // ID do vídeo no Vimeo (o admin faz upload direto no site do Vimeo e cola
  // aqui — nao construimos integracao de upload via API, sem ganho real
  // nesse estagio). `vimeoHash` e o parametro de "link privado" do Vimeo:
  // funciona em qualquer plano pago, e obscurece a URL (quem tem o link
  // inteiro consegue assistir de qualquer lugar — nao e uma trava tao forte
  // quanto a restricao por dominio do Vimeo Pro+, que exige plano melhor).
  vimeoId   String
  vimeoHash String?

  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  exerciciosVinculados Exercicio[]
  conteudosVinculados  ConteudoConsultoria[]
  aulasVinculadas      Aula[]
  bonusVinculados      Bonus[]

  @@map("videos")
}

// Catalogo de exercicios — reutilizavel entre alunos. O que muda de pessoa
// pra pessoa (series, repeticoes, carga) NAO fica aqui, fica na prescricao
// (TreinoExercicio) — assim o mesmo "Agachamento livre" serve pra varios
// alunos com numeros diferentes, sem duplicar a descricao/video/instrucoes.
model Exercicio {
  id String @id @default(uuid())

  nome       String
  descricao  String?
  instrucoes String?
  cuidados   String?

  // Imagens estaticas padrao (as mesmas que aparecem nos aparelhos/na
  // internet) — nao e arte custom por exercicio. `imagemAnatomica` e o
  // caminho de um preset fixo (grupo muscular), escolhido pelo admin numa
  // lista, nao um upload novo por exercicio.
  grupoMuscularPrincipal      String?
  gruposMuscularesSecundarios String[]
  imagemAnatomica             String?

  video   Video?  @relation(fields: [videoId], references: [id])
  videoId String?

  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  prescricoes TreinoExercicio[]
  execucoes   ExecucaoExercicio[]

  @@map("exercicios")
}

// A ficha de treino de UM aluno especifico. Diferente de Plano/Horario/Video
// (que controlam acesso por `produto`), aqui o controle e por DONO — o aluno
// so ve o proprio Treino, nunca o de outro aluno.
model Treino {
  id String @id @default(uuid())

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId String

  nome  String // ex: "Treino A - Superior"
  ativo Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  exercicios TreinoExercicio[]

  @@map("treinos")
}

// A prescricao em si: ESSE exercicio, NESSE treino, com ESSES numeros.
// Series/repeticoes/carga/descanso ficam como texto livre de proposito —
// "8 a 12", "peso corporal", "60s" sao formas reais de prescrever que um
// numero fixo nao capturaria.
model TreinoExercicio {
  id String @id @default(uuid())

  treino   Treino @relation(fields: [treinoId], references: [id], onDelete: Cascade)
  treinoId String

  exercicio   Exercicio @relation(fields: [exercicioId], references: [id])
  exercicioId String

  ordem       Int
  series      Int?
  repeticoes  String?
  carga       String?
  descanso    String?
  observacoes String?

  @@map("treino_exercicios")
}

// Conteudo da mentoria — acesso por PRODUTO (igual Video), nao por dono:
// todo mentorado com assinatura MENTORIA ativa ve o mesmo catalogo.
// `publicadoEm` no futuro = o admin agenda o video da semana com
// antecedencia e ele "destrava" sozinho na data certa, sem precisar logar
// toda semana pra publicar.
model ConteudoConsultoria {
  id String @id @default(uuid())

  pilar Pilar
  tipo  TipoConteudo @default(PADRAO)

  titulo    String
  descricao String?

  video   Video?  @relation(fields: [videoId], references: [id])
  videoId String?

  publicadoEm DateTime @default(now())
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now())

  @@map("conteudos_consultoria")
}

// A META de um usuario pra um tipo de habito. So uma por usuario+tipo — nao
// faz sentido ter 2 metas de agua ativas ao mesmo tempo pra mesma pessoa.
model Habito {
  id String @id @default(uuid())

  usuario   Usuario    @relation(fields: [usuarioId], references: [id])
  usuarioId String
  tipo      TipoHabito

  metaValor Float // litros (agua) ou horas (sono)

  // So a PREFERENCIA guardada aqui — quem efetivamente dispara o lembrete
  // (e-mail, push...) e a Fase 10 (Alertas), que le esses dois campos.
  lembreteHorario String? // "07:00"
  lembreteAtivo   Boolean @default(true)

  criadoEm DateTime @default(now())

  registros HabitoRegistro[]

  @@unique([usuarioId, tipo])
  @@map("habitos")
}

// O valor registrado em UM dia. Unique em (habito, data) — registrar de novo
// no mesmo dia ATUALIZA o valor, nao cria uma segunda linha duplicada.
model HabitoRegistro {
  id String @id @default(uuid())

  habito   Habito @relation(fields: [habitoId], references: [id], onDelete: Cascade)
  habitoId String

  data  DateTime @db.Date
  valor Float

  criadoEm DateTime @default(now())

  @@unique([habitoId, data])
  @@map("habito_registros")
}

// Mensagem motivacional/orientacao — mesmo mecanismo de agendamento do
// ConteudoConsultoria (Fase 8): `publicadoEm` no futuro fica invisivel ate
// a data chegar. So existe UMA mensagem "vigente" por vez — a mais recente
// cujo publicadoEm ja passou.
model MensagemMentalidade {
  id String @id @default(uuid())

  texto      String
  frequencia FrequenciaMensagem @default(DIARIA)

  publicadoEm DateTime @default(now())
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now())

  @@map("mensagens_mentalidade")
}

// `chaveDedup` e o que impede o motor de gerar o MESMO alerta toda vez que
// roda (ex: se checar a cada hora, nao quero 24 alertas por dia dizendo a
// mesma coisa). E uma string que a Fase 10 monta pra ser unica por
// situacao+dia (ex: "habito:<id>:2026-08-24").
model Alerta {
  id String @id @default(uuid())

  usuario   Usuario    @relation(fields: [usuarioId], references: [id])
  usuarioId String
  tipo      TipoAlerta
  mensagem  String

  lido Boolean @default(false)

  chaveDedup String @unique

  criadoEm DateTime @default(now())

  @@map("alertas")
}

// Log das acoes administrativas que mexem em acesso/dinheiro (item de LGPD
// do briefing: "logs de acoes administrativas relevantes"). Nao registra
// TUDO que o admin clica — so o que envolve conceder/revogar acesso ou
// dinheiro, que e o que realmente importa auditar depois.
model LogAdmin {
  id String @id @default(uuid())

  admin   Usuario @relation(fields: [adminId], references: [id])
  adminId String

  acao       String // ex: "concedeu cortesia", "desativou plano"
  entidade   String // ex: "Assinatura", "Plano"
  entidadeId String?

  criadoEm DateTime @default(now())

  @@map("logs_admin")
}

// Guarda so o HASH do token de recuperacao de senha, nunca o token em si —
// mesma logica do cpfHash: se o banco vazar, ninguem consegue usar essas
// linhas pra invadir uma conta. O token de verdade so existe no link que
// vai por e-mail, nunca no banco.
model TokenRecuperacaoSenha {
  id String @id @default(uuid())

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId String

  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?

  criadoEm DateTime @default(now())

  @@map("tokens_recuperacao_senha")
}

// ---------------------------------------------------------------------------
// Metodo Lider (Fase 12) — historico de execucao, avaliacoes, nutricao,
// anamnese, fotos e mensagens. Ver design_handoff_aluno_b2c/README.md
// pras telas que consomem cada um desses modelos.
// ---------------------------------------------------------------------------

// Respostas do onboarding (handoff, tela 3a). Uma por usuario — se precisar
// atualizar (aluno mudou de objetivo, nova lesao), o admin edita os campos
// direto, nao criamos historico disso (diferente da Avaliacao, que E
// historico por definicao).
model Anamnese {
  id String @id @default(uuid())

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId String  @unique

  tempoTreino      TempoTreino
  diasDisponiveis  Int // 1 a 7 (validado na aplicacao)
  objetivo         ObjetivoAluno
  lesoesRestricoes String? // texto livre — vira o card "ATENÇÃO" na tela do aluno pro admin

  respondidoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("anamneses")
}

// Uma avaliacao fisica (peso, medidas, % gordura) num ponto no tempo.
// NUNCA sobrescreve a anterior — o valor do produto e justamente comparar
// duas linhas (inicial vs. 30/60/90 dias) pra gerar o relatorio que o
// Victor usa pra decidir o que ajustar no aluno.
model Avaliacao {
  id String @id @default(uuid())

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId String

  data                    DateTime @db.Date
  peso                    Float? // kg
  altura                  Float? // cm
  percentualGordura       Float?
  // Circunferencias e outras medidas: guardado como JSON (ex: {"cintura":
  // 92, "bracoDireito": 34}) porque o briefing pede "outras medidas
  // relevantes" sem fechar a lista — um campo fixo por medida exigiria
  // migration toda vez que o Victor quisesse medir algo novo. Validado por
  // zod na camada de aplicacao, nao pelo banco.
  medidas                 Json?
  observacoesNutricionais String?

  criadoEm DateTime @default(now())

  @@map("avaliacoes")
}

// UMA serie executada, de UM exercicio, num treino. Vinculado a Usuario +
// Exercicio diretamente (nao a TreinoExercicio/prescricao) — assim "ultima
// vez que fiz supino reto" continua funcionando mesmo depois que o admin
// reescreve a ficha. `numeroSerie` + unique em (usuario, exercicio, data,
// numeroSerie) permite salvar cada serie conforme o aluno registra (o
// design pede salvamento otimista por serie) sem duplicar linha se ele
// corrigir um valor.
model ExecucaoExercicio {
  id String @id @default(uuid())

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId String

  exercicio   Exercicio @relation(fields: [exercicioId], references: [id])
  exercicioId String

  data        DateTime @db.Date
  numeroSerie Int
  carga       Float?
  repeticoes  Int?
  observacoes String?

  criadoEm DateTime @default(now())

  @@unique([usuarioId, exercicioId, data, numeroSerie])
  @@map("execucoes_exercicio")
}

// O plano alimentar de UM aluno — so existe pra quem tem `incluiNutricao`
// no plano contratado. Um por aluno (o admin edita em cima do mesmo plano
// em vez de criar um novo toda semana — o handoff mostra "Plano alimentar
// · semana 6" como rotulo de acompanhamento, nao como um plano diferente
// a cada semana).
model PlanoNutricional {
  id String @id @default(uuid())

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId String  @unique

  metaAguaLitros Float?
  metaSonoHoras  Float?
  metaProteinaG  Float?

  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  refeicoes Refeicao[]

  @@map("planos_nutricionais")
}

// Uma refeicao dentro do plano (Cafe da manha, Almoco...). `composicao` e
// texto livre de proposito — mesma logica do TreinoExercicio: e uma forma
// real de descrever "3 ovos - 60g aveia - 1 banana" que colunas fixas nao
// capturariam bem, e o briefing probe o app de nao inventar/prescrever
// nutricao automaticamente, entao nao ha ganho em modelar alimento como
// entidade relacional separada.
model Refeicao {
  id String @id @default(uuid())

  planoNutricional   PlanoNutricional @relation(fields: [planoNutricionalId], references: [id], onDelete: Cascade)
  planoNutricionalId String

  nome       String // "Cafe da manha", "Almoco"...
  horario    String? // "07:30"
  composicao String
  kcal       Int?
  ordem      Int

  checkins CheckinNutricional[]

  @@map("refeicoes")
}

// O check-in de UMA refeicao num dia especifico. Unique em (refeicao,
// data) — igual HabitoRegistro, registrar de novo no mesmo dia atualiza,
// nao duplica.
model CheckinNutricional {
  id String @id @default(uuid())

  refeicao   Refeicao @relation(fields: [refeicaoId], references: [id], onDelete: Cascade)
  refeicaoId String

  data                DateTime                 @db.Date
  status              StatusCheckinNutricional
  observacaoAdaptacao String? // preenchido so quando status = ADAPTOU

  criadoEm DateTime @default(now())

  @@unique([refeicaoId, data])
  @@map("checkins_nutricionais")
}

// Foto de acompanhamento (handoff, tela 7 "Evolucao"). Guardada no
// Cloudinary (plano gratuito) — aqui so a URL e a legenda.
// Foto de progresso do aluno. Diferente das outras imagens do app, ESTA
// NAO fica com URL publica no Cloudinary — e foto de corpo, o dado mais
// sensivel que guardamos.
//
// Por isso nao existe campo `url` aqui: guardamos so o identificador
// interno no Cloudinary (`publicId`), o arquivo la e do tipo
// "authenticated" (caminho publico devolve 404), e quem entrega a imagem
// pro navegador e a rota /api/fotos-progresso/[id], que confere sessao e
// dono a cada acesso. Guardar a URL assinada no banco nao adiantaria: a
// assinatura do Cloudinary nao expira, entao ela vazada uma vez vale pra
// sempre — o controle tem que ser nosso, requisicao a requisicao.
model FotoProgresso {
  id String @id @default(uuid())

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId String

  publicId String // ex: "vc-personal/fotos-progresso/abc123"
  formato  String // ex: "jpg" — o Cloudinary precisa disso pra montar a URL
  legenda  String? // ex: "semana 1 - frente"

  criadoEm DateTime @default(now())

  @@map("fotos_progresso")
}

// Mensagem de chat entre um aluno e o admin. `usuarioId` identifica DE QUEM
// e a thread (sempre o aluno) — como so existe 1 admin (decisao ja tomada
// no projeto), a thread inteira e "usuario X conversando com o Victor", sem
// precisar de uma tabela Conversa/participantes. `autorId` diz quem
// escreveu essa mensagem especifica dentro da thread (o proprio aluno ou o
// admin respondendo).
model Mensagem {
  id String @id @default(uuid())

  usuario   Usuario @relation("ThreadDoAluno", fields: [usuarioId], references: [id])
  usuarioId String

  autor   Usuario @relation("AutorMensagem", fields: [autorId], references: [id])
  autorId String

  texto String
  lida  Boolean @default(false)

  // --- Ancora na aula (Mentoria B2B, handoff 5f) ---
  // Preenchidos so quando a mensagem nasceu do botao "Enviar duvida desta
  // aula" no player — e o que permite o card clicavel "Modulo 2 · Aula 4 ·
  // 15:32" acima da bolha, e o "Abrir no ponto" que retoma o video ali.
  aula              Aula?   @relation(fields: [aulaId], references: [id])
  aulaId            String?
  timestampSegundos Int?

  // Marca "TAREFA PARA A PROXIMA SESSAO" (handoff 6d, atalho "Levar para a
  // sessao"). Continua sendo uma Mensagem normal na thread — so ganha esse
  // destaque visual, sem precisar de tabela separada.
  tarefa Boolean @default(false)

  criadoEm DateTime @default(now())

  @@map("mensagens")
}

// Tentativa de login/cadastro/recuperacao que FALHOU, usada pra limitar
// forca bruta. Fica no banco (e nao em memoria) de proposito: a Render
// reinicia o processo a cada deploy e derruba o servico quando fica ocioso
// no plano free — um contador em memoria zeraria junto, que e exatamente o
// que um atacante precisaria pra continuar tentando.
//
// `chave` e o alvo da tentativa (e-mail normalizado, prefixado pela acao),
// nao o IP: IP muda facil e ainda seria dado pessoal a mais pra guardar.
model TentativaAutenticacao {
  id    String @id @default(uuid())
  chave String

  criadoEm DateTime @default(now())

  @@index([chave, criadoEm])
  @@map("tentativas_autenticacao")
}

// ---------------------------------------------------------------------------
// Mentoria B2B (28/08/2026) — trilha de conteudo, bonus e comunidade.
// Handoff em handoff_mentoria_b2b_metodo_lider/. Reaproveita o que ja
// existia pra ALUNO/MENTORIA sem duplicar: Plano/Assinatura (nivel e
// limite de sessoes), Agendamento/Horario (sessoes 1-on-1), Video
// (hospedagem no Vimeo), Mensagem (canal direto, agora com ancora de
// aula). So o que faltava — trilha organizada, bonus com prazo, comunidade
// — ganha modelo novo.
// ---------------------------------------------------------------------------

enum StatusPublicacao {
  RASCUNHO
  AGENDADA
  PUBLICADA
}

enum TipoPost {
  RESULTADO
  DUVIDA
  GERAL
}

// Um pilar da trilha (reaproveita o enum Pilar ja usado no ConteudoConsultoria
// da Fase 8). "N de M aulas" e "Continue de onde parou" (handoff 5b/5c) sao
// calculados a partir daqui, nao guardados.
model Modulo {
  id    String @id @default(uuid())
  pilar Pilar

  titulo    String
  descricao String?

  // Ordem de exibicao pro mentorado — "a ordem aqui e a ordem que o
  // mentorado ve" (handoff 6b). Arrastavel no admin.
  ordem Int

  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  aulas Aula[]

  @@map("modulos")
}

// Uma aula de video dentro de um modulo. `prazoAcessoDias` e relativo a
// quando o CONTEUDO foi publicado, nao a quando cada mentorado assiste —
// e assim que o handoff descreve o selo "Acesso por mais N dias": um
// prazo fixo por aula, igual pra todo mundo que ve ela.
model Aula {
  id       String @id @default(uuid())
  modulo   Modulo @relation(fields: [moduloId], references: [id])
  moduloId String

  titulo    String
  descricao String? // aparece em "Nesta aula"

  video   Video?  @relation(fields: [videoId], references: [id])
  videoId String?

  materialUrl String? // PDF anexo (Cloudinary, resource_type raw)

  ordem Int

  // Sem prazo = null = acesso enquanto a assinatura estiver ativa. Com
  // prazo = dias contados a partir de `publicadoEm`. Calculado no server
  // (nunca no cliente), como o handoff exige explicitamente.
  prazoAcessoDias Int?

  status      StatusPublicacao @default(RASCUNHO)
  publicadoEm DateTime?

  // "Quem ve": planos de MENTORIA que liberam essa aula. Vazio = invisivel
  // pra todo mundo (rascunho de visibilidade, nao so de conteudo).
  planosVisiveis Plano[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  progresso          Progresso[]
  mensagensAncoradas Mensagem[]

  @@unique([moduloId, ordem])
  @@map("aulas")
}

// Posicao de reproducao de UM usuario em UMA aula — "retomar de onde
// parou" (handoff, Interacoes e comportamento). `concluida` tambem marca
// automaticamente ao passar de ~95% (regra aplicada na action, nao aqui).
model Progresso {
  id String @id @default(uuid())

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId String
  aula      Aula    @relation(fields: [aulaId], references: [id])
  aulaId    String

  posicaoSegundos Int     @default(0)
  concluida       Boolean @default(false)

  atualizadoEm DateTime @updatedAt

  @@unique([usuarioId, aulaId])
  @@map("progresso_aulas")
}

// Masterclass/bonus com janela de disponibilidade. O contador que o
// mentorado ve ("Disponivel por mais 18h") e sempre `expiraEm - agora`,
// calculado no server — os campos abaixo sao a unica fonte de verdade.
model Bonus {
  id String @id @default(uuid())

  titulo    String
  descricao String?

  video   Video?  @relation(fields: [videoId], references: [id])
  videoId String?

  liberaEm DateTime @default(now())
  expiraEm DateTime

  destaque Boolean @default(false)

  notificarPush  Boolean @default(false)
  lembrar3hAntes Boolean @default(false)

  criadoEm DateTime @default(now())

  @@map("bonus")
}

// Post da comunidade fechada dos mentorados. `ticketAntes`/`ticketDepois`
// so fazem sentido quando `tipo = RESULTADO` (handoff 5e: comparativo de
// ticket antes/depois) — ficam null nos outros tipos.
model Post {
  id String @id @default(uuid())

  autor   Usuario  @relation(fields: [autorId], references: [id])
  autorId String
  tipo    TipoPost @default(GERAL)

  texto String

  ticketAntes  Decimal? @db.Decimal(10, 2)
  ticketDepois Decimal? @db.Decimal(10, 2)

  // "Destacar" (handoff 6e) fixa o post no topo do feed. "Ocultar" remove
  // do feed mantendo o registro — nunca DELETE, so essa flag.
  destacado Boolean @default(false)
  oculto    Boolean @default(false)

  criadoEm DateTime @default(now())

  comentarios Comentario[]
  curtidas    Curtida[]
  denuncias   Denuncia[]

  @@map("posts")
}

// Comentario num post, com aninhamento de 1 nivel (resposta a um
// comentario) via `paiId` opcional — suficiente pro "filete dourado a
// esquerda" do handoff, sem precisar de arvore recursiva de verdade.
model Comentario {
  id String @id @default(uuid())

  post   Post   @relation(fields: [postId], references: [id])
  postId String

  autor   Usuario @relation(fields: [autorId], references: [id])
  autorId String

  pai       Comentario?  @relation("RespostasComentario", fields: [paiId], references: [id])
  paiId     String?
  respostas Comentario[] @relation("RespostasComentario")

  texto String

  // Mesma regra do Post: moderar NUNCA apaga. Ocultar tira do feed e mantem
  // o registro — se a remocao for contestada, da pra reler o que foi dito.
  // Ate 10/09/2026 comentario nao tinha moderacao nenhuma: o Victor podia
  // ocultar um post inteiro, mas nao um comentario ofensivo dentro dele.
  oculto Boolean @default(false)

  criadoEm DateTime @default(now())

  denuncias Denuncia[]

  @@map("comentarios")
}

// "Curtir e otimista" (handoff) — precisa persistir quem curtiu pra saber
// se o coracao fica dourado ao recarregar, e pra impedir curtida duplicada
// (unique usuario+post).
model Curtida {
  id String @id @default(uuid())

  post      Post    @relation(fields: [postId], references: [id])
  postId    String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId String

  criadoEm DateTime @default(now())

  @@unique([postId, usuarioId])
  @@map("curtidas")
}

// Diagnostico do mentorado no primeiro acesso (28/08/2026).
//
// Serve a tres coisas ao mesmo tempo, e a terceira e a que mais importa
// pro negocio: (1) o Victor entende com quem esta falando antes da
// primeira sessao; (2) a plataforma deixa de ser uma tela vazia no dia 1;
// (3) cria a LINHA DE BASE do resultado. Sem isso, o "ticket antes ->
// depois" so existe quando alguem resolve contar num post da comunidade —
// com isso, o Victor tem prova agregada real do que a mentoria entrega,
// que e argumento de venda, nao so metrica.
//
// `ticketAtual` e revisitavel: a ideia e o mentorado atualizar de tempos
// em tempos, e a diferenca contra `ticketInicial` virar o resultado dele.
model Diagnostico {
  id String @id @default(uuid())

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId String  @unique

  // Snapshot da entrada — nunca muda depois de gravado.
  ticketInicial Decimal @db.Decimal(10, 2)
  alunosInicial Int
  // Texto livre: o gargalo que a pessoa mesma identifica. Vale mais como
  // insumo de conversa do que como categoria fechada.
  maiorGargalo  String

  // Atualizavel — e o que gera a comparacao.
  ticketAtual Decimal? @db.Decimal(10, 2)
  alunosAtual Int?

  respondidoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("diagnosticos")
}

// Denuncia feita por um mentorado sobre um post ou comentario.
//
// Sem isso, "ter um moderador olhando" significaria o Victor ler cada post e
// cada comentario todo dia pra descobrir se algo saiu da linha — o que na
// pratica quer dizer que ninguem esta olhando. Quem esta no feed ve primeiro;
// a denuncia e o que transforma isso em fila de trabalho pra ele.
model Denuncia {
  id String @id @default(uuid())

  // Um dos dois, nunca os dois: a denuncia e de um post OU de um comentario.
  post         Post?       @relation(fields: [postId], references: [id])
  postId       String?
  comentario   Comentario? @relation(fields: [comentarioId], references: [id])
  comentarioId String?

  denunciante   Usuario @relation("Denunciante", fields: [denuncianteId], references: [id])
  denuncianteId String

  motivo  MotivoDenuncia
  detalhe String?

  criadoEm DateTime @default(now())

  // Resolvida = o Victor ja olhou e decidiu (ocultando ou nao). Guardar quem
  // resolveu e quando torna a moderacao auditavel, em vez de sumir da fila
  // sem deixar rastro.
  resolvidoEm    DateTime?
  moderador      Usuario?  @relation("ModeradorDenuncia", fields: [moderadorId], references: [id])
  moderadorId    String?
  acaoTomada     String?

  // Uma denuncia por pessoa por conteudo — se alguem clicar duas vezes, nao
  // vira duas linhas na fila. Varias pessoas denunciando o mesmo conteudo
  // continuam contando separado, que e o sinal que importa.
  @@unique([denuncianteId, postId, comentarioId])
  @@index([resolvidoEm])
  @@map("denuncias")
}

enum MotivoDenuncia {
  SPAM
  OFENSA
  CONTEUDO_IMPROPRIO
  FORA_DO_TEMA
  OUTRO
}
