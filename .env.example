# Copie este arquivo para ".env" e preencha com os valores reais.
# ".env" nunca é commitado (veja .gitignore) — só este .example fica no Git.

# Connection string "pooled" da Neon (com pgbouncer) — usada pela aplicação em runtime.
# Pegue em: console.neon.tech > seu projeto > Connect > Pooled connection
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.sa-east-1.aws.neon.tech/vc_personal?sslmode=require"

# Connection string direta (sem pooler) — usada só para rodar migrations.
# Mesma tela da Neon, aba "Direct connection" (host sem o sufixo "-pooler").
DIRECT_URL="postgresql://usuario:senha@ep-exemplo.sa-east-1.aws.neon.tech/vc_personal?sslmode=require"

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="cole-aqui-uma-string-aleatoria-de-32-bytes"

# URL onde o app está rodando — usada pra montar links de volta e o endereço
# que o Mercado Pago chama depois do pagamento. Em produção vira o domínio real.
APP_URL="http://localhost:3000"

# Painel do Mercado Pago > Suas integrações > (sua aplicação) > Credenciais de teste.
# Comece com as credenciais de TESTE (começam com "TEST-") — nunca use produção em dev.
MP_ACCESS_TOKEN="TEST-cole-aqui-o-access-token-de-teste"

# Mesma tela, aba "Webhooks" > Chave secreta — usada pra confirmar que uma
# notificação de pagamento realmente veio do Mercado Pago.
MP_WEBHOOK_SECRET="cole-aqui-a-chave-secreta-do-webhook"

# Protege /api/cron/alertas — só quem sabe essa senha consegue disparar a
# geração de alertas. Gere com:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET="cole-aqui-uma-string-aleatoria"
